# ── IBM watsonx.ai Credentials ──────────────────────────────────────────────
# Your IBM Cloud API key from https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# watsonx.ai service URL — choose your region:
#   Dallas (us-south): https://us-south.ml.cloud.ibm.com
#   Frankfurt (eu-de):  https://eu-de.ml.cloud.ibm.com
#   Sydney (au-syd):    https://au-syd.ml.cloud.ibm.com
#   Tokyo (jp-tok):     https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://au-syd.ml.cloud.ibm.com

# Your watsonx.ai project ID from the project settings page
WATSONX_PROJECT_ID=your_project_id_here

# Model to use for generation
# Options: meta-llama/llama-3-3-70b-instruct, ibm/granite-3-2-8b-instruct
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# ── App Settings ─────────────────────────────────────────────────────────────
# A random secret key for Flask session signing — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# Directory to persist FAISS vector stores (will be created automatically)
VECTOR_STORE_DIR=data/vector_stores
